<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The error "Cannot resolve symbol" was because the Material library was missing.
         I have added it to your app/build.gradle.kts. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- 🚨 CRITICAL: Set this to false. 'true' is what causes the blank/black screen delay. -->
        <item name="android:windowDisablePreview" tools:ignore="NewApi">false</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor" tools:ignore="NewApi">@color/app_color_status_bar</item>
        <item name="android:windowLightStatusBar" tools:ignore="NewApi">true</item>
        
    </style>

    <!-- Flutter expects these themes to manage the transition from native to Flutter UI -->
    <style name="LaunchTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>

    <style name="NormalTheme" parent="AppTheme">
        <item name="android:windowBackground">@color/splash_color</item>
    </style>
</resources>
