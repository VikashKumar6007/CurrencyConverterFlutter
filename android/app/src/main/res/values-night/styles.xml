<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- 🚨 FIXED: Set to false to show the splash color immediately -->
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/app_color_status_bar</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Required for Flutter transition -->
    <style name="LaunchTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>

    <style name="NormalTheme" parent="AppTheme">
        <item name="android:windowBackground">@color/splash_color</item>
    </style>
</resources>
